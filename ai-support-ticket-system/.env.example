# Replace these values with the local PostgreSQL role and password you use.
# If your PostgreSQL role is your macOS account, change postgres to that name.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/ai_support

# Generate a long random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
